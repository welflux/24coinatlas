# Development defaults. Copy to .env locally; never commit credentials.
APP_ORIGIN=http://localhost:3000
PORT=3001
DATA_DIR=.data
# Set TRUST_PROXY=1 only behind exactly one trusted reverse proxy.
TRUST_PROXY=0

FREE_MONTHLY_SCANS=5
PRO_MONTHLY_SCANS=100
FREE_COLLECTION_LIMIT=25
PRO_COLLECTION_LIMIT=1000
# Proposed ZAR monthly price in cents, pending demand validation.
PRO_PRICE_MINOR=12900

# Optional identification integration. Blank means explicitly unavailable.
COIN_AI_API_KEY=
COIN_AI_MODEL=gpt-4.1-mini

# Paystack South African merchant account + a ZAR monthly plan required.
PAYSTACK_SECRET_KEY=
# Raw server-side merchant key for local HMAC verification. A network-proxy
# placeholder cannot be used here. Supply via a secure runtime secret store.
PAYSTACK_WEBHOOK_SECRET=
PAYSTACK_PLAN_CODE=
# Leave false until launch checks and genuine paid services are verified.
BILLING_ENABLED=false
PAID_FEATURES_READY=false

# Optional account-email integration. Production requires verified addresses by default.
RESEND_API_KEY=
MAIL_FROM=
# Leave unset to require verification in production and allow local development.
# REQUIRE_EMAIL_VERIFICATION=true
